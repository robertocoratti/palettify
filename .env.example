# Copy this file to .env for local development.
# In production, set these as platform environment variables — never commit .env.

# TCP port the server listens on.
PORT=3000

# Set to "production" to enable production log format and hide internal error details.
ENVIRONMENT=development

# Comma-separated list of valid API keys for the X-Api-Key header.
# Leave empty or unset to disable authentication (development only).
API_KEYS=sk_live_your_key_here,sk_live_another_key

# Maximum upload size in megabytes. Default: 50.
MAX_UPLOAD_MB=50

# Optional: path to a directory containing extra .txt palette files.
# Files in this directory are loaded on top of the embedded palettes.
# PALETTES_DIR=./palettes
